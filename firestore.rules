rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Una fila por historia: ranking/<uid>_<personaje>. Refleja la partida (los continues bajan el puntaje);
    // se borra al reiniciar o eliminar esa historia.
    match /ranking/{row} {
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','score','level','total','fighter','updatedAt'])
          && d.name is string && d.name.size() <= 12
          && d.score is int && d.score >= 0
          && d.fighter is string
          && row == request.auth.uid + '_' + d.fighter;
      }
      allow read: if true;
      allow create, update: if request.auth != null && valid();
      allow delete: if request.auth != null && row == request.auth.uid + '_' + resource.data.fighter;
    }

    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Nickname único: names/n_<NICKNAME> → { uid, name, createdAt }. Se crea una vez y no se cambia ni se borra.
    match /names/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','name','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9Ñ_-]{1,12}$')
        && key == 'n_' + request.resource.data.name.upper();
      allow update, delete: if false;
    }

    // Estadísticas (src/systems/Analytics.ts): analytics/accounts, analytics/day-<fecha>, analytics/week-<semana>, analytics/month-<mes>.
    // Cualquier cuenta solo suma; nadie borra. Leer: solo el administrador (dashboard.html).
    match /analytics/{id} {
      function admin() {
        return request.auth != null && request.auth.token.email == 'erodriguezp105@gmail.com' && request.auth.token.email_verified;
      }
      function counter(k) {
        return !(k in request.resource.data) || (request.resource.data[k] is int && request.resource.data[k] >= 0);
      }
      function valid() {
        let d = request.resource.data;
        return (id == 'accounts' && d.type == 'accounts' && d.keys().hasOnly(['type','total']) && counter('total'))
          || (id == 'day-' + d.get('date', '') && d.type == 'day'
              && d.keys().hasOnly(['type','date','players','new','fights','fighters','stages','modes'])
              && counter('players') && counter('new') && counter('fights')
              && d.get('fighters', {}) is map && d.get('stages', {}) is map && d.get('modes', {}) is map)
          || (id == 'week-' + d.get('week', '') && d.type == 'week' && d.keys().hasOnly(['type','week','players']) && counter('players'))
          || (id == 'month-' + d.get('month', '') && d.type == 'month' && d.keys().hasOnly(['type','month','players']) && counter('players'));
      }
      // Los contadores no pueden bajar.
      function grows() {
        return resource == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','new','fights','fighters','stages','modes','total'])
          && (!('total' in resource.data) || request.resource.data.total >= resource.data.total)
          && (!('players' in resource.data) || request.resource.data.players >= resource.data.players)
          && (!('fights' in resource.data) || request.resource.data.fights >= resource.data.fights);
      }
      allow read: if admin();
      allow create: if request.auth != null && valid();
      allow update: if request.auth != null && valid() && grows();
      allow delete: if false;
    }
  }
}
